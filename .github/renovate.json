{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":pinDevDependencies"
  ],
  "labels": ["dependencies"],
  "baseBranches": ["main"],
  "terraform": {
    "fileMatch": ["terraform/.+\\.tf$"]
  },
  "packageRules": [
    {
      "description": "Terraform providers — group into a single PR per update cycle",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "groupName": "terraform-providers",
      "schedule": ["before 6am on monday"],
      "automerge": false
    },
    {
      "description": "GitHub Actions — pin to SHA, update weekly",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "schedule": ["before 6am on monday"],
      "automerge": false
    },
    {
      "description": "Terraform lockfile maintenance — regenerate .terraform.lock.hcl weekly",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["lockfile"],
      "schedule": ["before 6am on monday"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
