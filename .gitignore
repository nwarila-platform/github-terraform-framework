# Documentation directory (Diátaxis layout per ADR-0002).
!/docs/
!/docs/**

# Additions for terraform-template sync (Makefile, configs, helpers).
!/.terraform-docs.yml
!/.tflint.hcl
!/.pre-commit-config.yaml
!/.markdownlint-cli2.jsonc
!/Makefile
!/tools/
!/tools/check_docs_layout.py

# Contract files (seeded by seed_consumer.py)
!/terraform/locals.tf
!/terraform/outputs.tf
!/terraform/resources.tf
!/terraform/variables.tf
!/terraform/versions.tf
!/terraform/tests/.gitkeep
!/docs/README.md
!/docs/explanation/
!/docs/explanation/architecture.md
!/docs/explanation/testing-strategy.md
!/docs/explanation/threat-model.md
!/docs/reference/
!/docs/reference/terraform.md
!/docs/reference/release-gates.md
!/docs/reference/invariants.md
!/docs/how-to/
!/docs/how-to/develop-this-module.md
!/docs/decision-records/
!/docs/decision-records/README.md
!/policies/
!/policies/opa/
!/policies/opa/.gitkeep
!/CHANGELOG.md
!/release-please-config.json
!/.release-please-manifest.json
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md

# Universal config files (synced from terraform-template)
!/.editorconfig
