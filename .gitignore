# Ignore everything by default.
**

# Keep CI/CD workflows.
!/.github/
!/.github/renovate.json5
!/.github/workflows/
!/.github/workflows/template-sync.yaml
!/.github/workflows/pr-validation.yaml
!/.github/workflows/codeql.yaml
!/.github/workflows/security.yaml
!/.github/workflows/terraform-test.yml

# Keep core repo files.
!/.gitattributes
!/.gitignore
!/DESIGN.md
!/LICENSE
!/README.md
!/REVIEW_REMEDIATION_PLAN.md
!/PATCH_ANALYSIS_PLAN.md

# Keep Terraform module files.
!/terraform/
!/terraform/.terraform.lock.hcl
!/terraform/00-providers.tf
!/terraform/01-providers-github.tf
!/terraform/02-providers-aws.tf
!/terraform/11-variables.github.tf
!/terraform/30-locals.tf
!/terraform/41-resources-github.tf
!/terraform/60-outputs-github.tf

# Keep repo definition directories (consumer adds YAMLs here).
!/terraform/repos/
!/terraform/repos/public/
!/terraform/repos/public/.gitkeep
!/terraform/repos/private/
!/terraform/repos/private/.gitkeep

# Keep the test suite.
!/terraform/tests/
!/terraform/tests/COVERAGE.md
!/terraform/tests/normalization.tftest.hcl
!/terraform/tests/preconditions.tftest.hcl
!/terraform/tests/security.tftest.hcl
!/terraform/tests/validation.tftest.hcl

